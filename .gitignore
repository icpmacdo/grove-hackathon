# Dataset and derived data (gated, large; never commit)
data/
*.jsonl.gz
*.parquet
*.duckdb
*.duckdb.wal
*.tar

# Secrets
.env*
!.env.example

# Python / Node
.venv/
__pycache__/
*.pyc
node_modules/

# OS
.DS_Store

# Analysis outputs: derived data and excerpts of agent text stay local
analysis/**/*.csv
analysis/**/*.json
analysis/**/*.parquet
analysis/**/*.out.txt
analysis/**/out/
# Restrictions analysis was dropped; never commit it
analysis/boundaries/

# Tracer build output inlines agent text from the gated dataset
tracer/out/

# label.py writes atomically via a temp file; a hard kill can leave one behind
tracer/labels/.*.tmp
